# Anubis instance config for this deployment (docs/DEPLOYMENT.md step 5) — protects apps/web (the SvelteKit UI) from AI scraper bots, sitting between nginx and it.
# apps/api is deliberately NOT behind this instance: its own clients (API keys, the npm package, the /playground page's own server-side proxy) can't solve a JS challenge, and nginx's own /api/ location bypasses Anubis entirely (see the updated deploy-example/nginx/openmiq-api.conf).
#
# Installed at /etc/anubis/openmiq-web.env (native package) — see https://github.com/TecharoHQ/anubis/releases and https://anubis.techaro.lol/docs/admin/native-install for the install steps themselves, this file only covers what to put in the config once it's installed.

# A Unix socket, not a TCP port — matches the `upstream anubis` block in deploy-example/nginx/openmiq-api.conf. Change both together if you'd rather use a TCP port (e.g. 127.0.0.1:8923).
BIND=unix:/run/anubis/openmiq-web.sock
BIND_NETWORK=unix
DIFFICULTY=4
METRICS_BIND=127.0.0.1:9998
METRICS_BIND_NETWORK=tcp
# apps/web (PORT/HOST in the root .env) — not apps/api, and not through nginx, so a public bot request never has to solve the challenge twice.
TARGET=http://127.0.0.1:9414
