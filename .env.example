DATABASE_URL=file:./data/db.sqlite
SESSION_JWT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
DISCORD_REVIEW_WEBHOOK_URL=
ADMIN_DISCORD_IDS=
# Required. Unlike every other Discord credential above, this is a bot
# token, not an OAuth2 app secret — create a bot user for this application
# in the Discord Developer Portal to get one. Used to fetch a Discord
# user's avatar by id: the logged-in user's own avatar in the header, every
# avatar in the Admin user list, and the first ADMIN_DISCORD_IDS entry's
# avatar for the homepage's sample quote image at startup. Also needed to
# create DISCORD_REVIEW_WEBHOOK_URL above via this bot's own API call
# (README.md "Discord setup" step 5), not the channel's Integrations UI — a
# webhook created that way isn't application-owned, and Discord silently
# drops the Approve/Deny buttons from every message sent through it.
DISCORD_BOT_TOKEN=
# Optional. An invite link to this instance's own Discord server (a community for its users, unrelated to the Discord integration above) — when set, the Web UI shows a "join our Discord" note on the home page and the application form.
DISCORD_INVITE_URL=
# Lets /playground be used without signing up first — a visitor who leaves its API key field blank falls back to a key this app generates and manages entirely on its own (never written to config anywhere). 0 (default) disables the whole feature; a positive number is how many anonymous requests that shared key may serve per rotation (PLAYGROUND_SHARED_KEY_ROTATE_MINUTES) before further ones are refused, e.g. 500.
PLAYGROUND_SHARED_KEY_LIMIT=500
# How often the shared key above is thrown away and replaced with a freshly-generated one.
PLAYGROUND_SHARED_KEY_ROTATE_MINUTES=30
# A separate, small per-IP-address limit, on top of PLAYGROUND_SHARED_KEY_LIMIT's total — keeps a single visitor from exhausting that shared allocation for everyone else.
PLAYGROUND_RATE_LIMIT_WINDOW_MS=60000
PLAYGROUND_RATE_LIMIT_MAX=5
APP_BASE_URL=http://localhost:9413
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
# Unset = GET /api/branding/icon and /logo return 404 — there is no
# fallback to the bundled .github/assets/icon.png/logo.png, since those
# identify the original OpenMiQ project and author specifically
# (ADDITIONAL_TERMS.md §4). Set these explicitly (even to that same path,
# e.g. ICON_PATH=.github/assets/icon.png — a relative path resolves
# against the project root, same as this file) if you want an icon/logo
# served, on any deployment including the original one.
ICON_PATH=
LOGO_PATH=
REAPPLY_COOLDOWN_DAYS=1
MAX_API_KEYS_PER_USER=10
STORAGE_DRIVER=r2
STORAGE_LOCAL_DIR=./data/images
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# HOSTED_IMAGE_TTL_HOURS unset = images are kept indefinitely, see docs/DESIGN.md §8.6
HOSTED_IMAGE_TTL_HOURS=
TERMS_VERSION=1
PRIVACY_VERSION=1
DEFAULT_LOCALE=en
# apps/api's own port/bind address. Named API_PORT/API_HOST (not PORT/HOST)
# because @sveltejs/adapter-node below reads plain PORT/HOST for apps/web —
# reusing those names here would make the two apps fight over one value.
API_PORT=9413
API_HOST=0.0.0.0

# apps/web (SvelteKit) — where it reaches apps/api from the server side
API_BASE_URL=http://localhost:9413
# Read directly by @sveltejs/adapter-node (apps/web's production server),
# not by our own code. Set HOST=127.0.0.1 in production, same as API_HOST,
# once nginx is the only thing reaching either process (DESIGN.md §14.2).
PORT=9414
HOST=0.0.0.0
